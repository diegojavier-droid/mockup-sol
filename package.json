{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:server": "tsx watch server/src/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "db:generate-seed": "bun run scripts/generate-catalog-seed.ts",
    "db:apply": "supabase migration up --local",
    "test": "bun test server/src src/lib",
    "test:e2e": "bun run scripts/e2e-booking.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stack:up": "bash scripts/local-stack.sh up",
    "stack:down": "bash scripts/local-stack.sh down",
    "test:e2e:flow": "bash scripts/e2e-flow.sh",
    "test:e2e:stations": "bash scripts/e2e-stations.sh",
    "test:e2e:combo": "bash scripts/e2e-combo.sh",
    "test:e2e:dashboard": "bun run scripts/e2e-dashboard.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@eslint/js": "^9.32.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.62.1",
    "prettier": "^3.7.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "wrangler": "^4.114.0"
  }
}

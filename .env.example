# ---------------------------------------------------------------------------
# Sol Mai — server-only environment contract (Phase 1)
# ---------------------------------------------------------------------------
# These variables are consumed ONLY by the backend under server/.
# Never prefix sensitive values with VITE_. Never commit real values.
# See docs/backend-env.md for details.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
APP_ENV=local

# Base URLs
API_BASE_URL=http://localhost:3001
PUBLIC_WEB_BASE_URL=http://localhost:5173

# Supabase (server-only — SERVICE_ROLE_KEY is a hard secret)
# SUPABASE_PUBLISHABLE_KEY uses Supabase's public/publishable key format and
# respects RLS. The SERVICE_ROLE key must remain server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Internal auth (owner/staff console)
INTERNAL_AUTH_JWT_AUDIENCE=sol-mai-internal
INTERNAL_AUTH_ALLOWED_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Reserved for future phases — leave unset until the corresponding phase.
# ---------------------------------------------------------------------------
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# EMAIL_PROVIDER_API_KEY=
# WHATSAPP_PROVIDER_TOKEN=
# INTERNAL_SIGNING_SECRET=

# Optional
# PORT=3001

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sol-mai-peluqueria",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Barrido de reservas cuyo hold venció sin pago. La capacidad ya se
  // libera sola (booking_blocks deja de contarlas al vencer), pero la
  // fila queda en pending_payment: esto la cierra para que la agenda
  // muestre el estado real.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },

  // Sin esto el Worker se despliega sin dirección propia y no habría
  // nada que abrir en el navegador.
  "workers_dev": true,

  // Valores que no son secretos y no cambian entre despliegues. Lo que
  // sí es secreto —claves de Supabase, emails habilitados— lo carga el
  // workflow desde los secrets de GitHub, para que no viva en el repo.
  "vars": {
    "NODE_ENV": "production",
    "APP_ENV": "production",
    "INTERNAL_AUTH_JWT_AUDIENCE": "sol-mai-internal"
  }
}
